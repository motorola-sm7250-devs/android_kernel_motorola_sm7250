# Bluetooth device drivers "1336"
CONFIG_NFC=y

# Near Field Communication (NFC) devices
CONFIG_NFC_ST21NFC=m

# qrc device driver
CONFIG_AW8697_HAPTIC=m

# Input Device Drivers
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_MMI=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_MMI_CORE=m
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_MMI_RMI_DEV=m
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_MMI_FW_UPDATE=m
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_MMI_TEST_REPORTING=m
CONFIG_INPUT_TOUCHSCREEN_MMI=m
CONFIG_TOUCHSCREEN_SEC_TS=m
CONFIG_INPUT_STMVL53L1=m
CONFIG_INPUT_MISC_TOF_USE_VL53L3=y
CONFIG_FINGERPRINT_FPC_TEE_MMI=m

# MFD GPIO expanders
CONFIG_GPIO_MADERA=m

# Qualcomm Technologies, Inc. Charger and Fuel Gauge support
CONFIG_BQ27426_FG_MMI=m
CONFIG_QPNP_ADAPTIVE_CHARGE=m

# Multifunction device drivers
CONFIG_MFD_MADERA=m
CONFIG_MFD_MADERA_SPI=m
CONFIG_MFD_CS47L35=y
CONFIG_MFD_ARIZONA_SPI=y
CONFIG_REGULATOR_ARIZONA_LDO1=m
CONFIG_REGULATOR_ARIZONA_MICSUPP=m
CONFIG_REGULATOR_SLG51000=m

# CODEC drivers
CONFIG_CIRRUS_PLAYBACK=m
CONFIG_SND_SOC_AOV_TRIGGER=m
CONFIG_SND_SOC_CS35L41_SPI=m
CONFIG_SND_SOC_CS35L41_I2C=m
CONFIG_SND_SOC_CS47L35=m
CONFIG_SND_SOC_MADERA=m

# MMC/SD/SDIO Host Controller Drivers
# CONFIG_MMC_CQHCI is not set

# Extcon Device Drivers
CONFIG_EXTCON_MADERA=m
CONFIG_EXTCON_MADERA_INPUT_EVENT=y
