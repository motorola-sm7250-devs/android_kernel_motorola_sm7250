# qrc device driver
CONFIG_INPUT_AWINIC_HAPTIC=y
CONFIG_SARSENSOR_SX933X=m
CONFIG_CAPSENSE_USB_CAL=y
CONFIG_CAPSENSE_HEADSET_STATE=y
CONFIG_MOTO_UTAGS=m

# Input Device Drivers
CONFIG_INPUT_QPNP_POWER_ON_MMI=m

# Non-8250 serial port support
# CONFIG_SERIAL_MSM_GENI_CONSOLE is not set

# Qualcomm Technologies, Inc. Charger and Fuel Gauge support
CONFIG_QPNP_SMBCHARGER_MMI=m

# Frame buffer Devices
CONFIG_FB=y

# Qualcomm Atheros CLD WLAN module
CONFIG_QCA_CLD_WLAN=m

# Qualcomm SoC drivers
# CONFIG_MSM_PERFORMANCE is not set

# HW tracing support
CONFIG_SENSORS_CLASS=m
CONFIG_MMI_ANNOTATE=m
CONFIG_MMI_INFO=m
CONFIG_MOTO_F_USBNET=m
CONFIG_TZLOG_DUMP=m
CONFIG_WATCHDOG_CPU_CTX=m
CONFIG_WATCHDOGTEST=m
CONFIG_MMI_RELAY=m

# DOS/FAT/EXFAT/NT Filesystems
CONFIG_EXFAT_FS=m

# RCU Debugging
CONFIG_QCOM_RTB=y
CONFIG_QCOM_RTB_SEPARATE_CPUS=y
CONFIG_FUNCTION_TRACER=y
