# Bluetooth device drivers
CONFIG_NFC=y

# Near Field Communication (NFC) devices
CONFIG_NFC_ST21NFC=m

# qrc device driver
CONFIG_AW8695_HAPTIC=m
CONFIG_MMI_SIGPRINT=m
CONFIG_MMI_SYS_TEMP=m

# Input Device Drivers
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_MMI=y
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_MMI_I2C=m
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_MMI_CORE=m
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_MMI_DEVICE=m
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_MMI_TESTING=m
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_MMI_REFLASH=m
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_MMI_RECOVERY=m
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_MMI_ZEROFLASH=m
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_MMI_DIAGNOSTICS=m
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_MMI_GESTURES=y
CONFIG_TOUCHSCREEN_GOODIX_GTX8_MMI=m
CONFIG_TOUCHSCREEN_GOODIX_GTX8_MMI_GESTURES=y
CONFIG_TOUCHSCREEN_GOODIX_GTX8_MMI_UPDATE=m
CONFIG_TOUCHSCREEN_GOODIX_GTX8_MMI_TOOLS=m
CONFIG_INPUT_TOUCHSCREEN_MMI=m
CONFIG_TOUCHSCREEN_SEC_TS=m
CONFIG_INPUT_STMVL53L1=m
CONFIG_INPUT_MISC_TOF_USE_VL53L3=y
CONFIG_FINGERPRINT_GOODIX_FOD_MMI=m

# MFD GPIO expanders
CONFIG_GPIO_MADERA=m

# Multifunction device drivers
CONFIG_MFD_MADERA=m
CONFIG_MFD_MADERA_SPI=m
CONFIG_MFD_CS47L35=y
CONFIG_MFD_ARIZONA_SPI=y
CONFIG_REGULATOR_ARIZONA_LDO1=m
CONFIG_REGULATOR_ARIZONA_MICSUPP=m
CONFIG_REGULATOR_SLG5BM43670=m

# CODEC drivers
CONFIG_CIRRUS_PLAYBACK=m
CONFIG_SND_SOC_AOV_TRIGGER=m
CONFIG_SND_SOC_CS35L41_SPI=m
CONFIG_SND_SOC_CS47L35=m
CONFIG_SND_SOC_MADERA=m

# Extcon Device Drivers
CONFIG_EXTCON_MADERA=m
CONFIG_EXTCON_MADERA_INPUT_EVENT=y
