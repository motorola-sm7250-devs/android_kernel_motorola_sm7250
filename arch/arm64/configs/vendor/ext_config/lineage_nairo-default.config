# Bluetooth device drivers
CONFIG_NFC=y

# Near Field Communication (NFC) devices
CONFIG_NFC_ST21NFC=m

# qrc device driver
CONFIG_AW8695_HAPTIC=m
CONFIG_MMI_SIGPRINT=m
CONFIG_MMI_SYS_TEMP=m

# Input Device Drivers
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM is not set
# CONFIG_TOUCHSCREEN_FTS is not set
CONFIG_TOUCHSCREEN_NT36xxx_HOSTDL_SPI_MMI=m
CONFIG_INPUT_NOVA_0FLASH_MMI_ENABLE_DOUBLE_TAP=y
CONFIG_INPUT_NOVA_PANEL_NOTIFICATIONS=y
CONFIG_INPUT_NOVA_PANEL_ESD_ENABLE=y
CONFIG_FINGERPRINT_EGISTEC_FPS_MMI=m
CONFIG_EGIS_DISPLAY_SPEED_UP=y
CONFIG_FINGERPRINT_FPC_TEE_MMI=m

# Multifunction device drivers
CONFIG_REGULATOR_WL2864C=m

# Supported MMC/SDIO adapters
CONFIG_RADIO_ELNA=m

# HW tracing support
CONFIG_TRUSTONIC_TEE=m
CONFIG_RSU_SELECT_SILVER_CORES=y
CONFIG_RSU_SELECT_INTERNAL_CLOCK=y
