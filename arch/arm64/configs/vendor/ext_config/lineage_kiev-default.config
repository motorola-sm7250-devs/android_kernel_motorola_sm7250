# qrc device driver
CONFIG_INPUT_AWINIC_HAPTIC=y
CONFIG_AW8624_HAPTIC=m
CONFIG_MMI_SIGPRINT=m
CONFIG_MMI_SYS_TEMP=m
CONFIG_SARSENSOR_SX933X=m
CONFIG_CAPSENSE_USB_CAL=y
CONFIG_CAPSENSE_HEADSET_STATE=y
CONFIG_MOTO_UTAGS=m

# Input Device Drivers
CONFIG_TOUCHSCREEN_FTS_0FLASH_MMI=m
CONFIG_INPUT_FOCALTECH_0FLASH_MMI_IC_NAME_FT8756=y
CONFIG_TOUCHSCREEN_FTS_0FLASH_MMI_ENABLE_DOUBLE_TAP=y
CONFIG_TOUCHSCREEN_FTS_0FLASH_MMI_ESD_ENABLE=y
CONFIG_INPUT_TOUCHSCREEN_MMI=m
CONFIG_TOUCHCLASS_MMI_GESTURE_POISON_EVENT=y
CONFIG_INPUT_QPNP_POWER_ON_MMI=m
CONFIG_FINGERPRINT_EGISTEC_FPS_MMI=m
CONFIG_EGIS_DISPLAY_SPEED_UP=y

# Qualcomm Technologies, Inc. Charger and Fuel Gauge support
CONFIG_QPNP_ADAPTIVE_CHARGE=m
CONFIG_QPNP_SMBCHARGER_MMI=m

# Multifunction device drivers
CONFIG_REGULATOR_WL2864C=m

# Webcam, TV (analog/digital) USB devices
CONFIG_SPECTRA_CAMERA=y
CONFIG_DVB_MPQ=m
CONFIG_DVB_MPQ_DEMUX=m
CONFIG_DVB_MPQ_SW=y

# Supported MMC/SDIO adapters
CONFIG_RADIO_ELNA=m

# HW tracing support
CONFIG_SENSORS_CLASS=m
CONFIG_MMI_ANNOTATE=m
CONFIG_MMI_INFO=m
CONFIG_MOTO_F_USBNET=m
CONFIG_TZLOG_DUMP=m
CONFIG_WATCHDOG_CPU_CTX=m
CONFIG_WATCHDOGTEST=m
CONFIG_MMI_RELAY=m
CONFIG_TRUSTONIC_TEE=m
CONFIG_RSU_SELECT_SILVER_CORES=y
CONFIG_RSU_SELECT_INTERNAL_CLOCK=y

# Frame buffer Devices
CONFIG_FB=y
